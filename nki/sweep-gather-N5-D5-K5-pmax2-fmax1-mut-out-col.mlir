  %v639 = sea.ptr.add %v7, %v638 : !sea.ptr<64>, i64
  %v640 = sea.load %v212[%v639] align 1 : !m -> i8 loc("spec.actual")
  %v641 = sea.icmp eq, %v640, %v467 : i8
  %v642 = sea.and %v635, %v641 : i1
  sea.assert %v642
