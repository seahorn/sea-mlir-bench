  %v911 = sea.ptr.add %v4, %v362 : !sea.ptr<64>, i64
  %v912 = sea.load %v436[%v911] align 2 : !m -> i16 loc("spec.out")
  %v913 = sea.icmp eq, %v912, %v834 : i16
  %v914 = sea.and %v910, %v913 : i1
  sea.assert %v914
  sea.halt
}
